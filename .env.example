# Local development — copy to .env and adjust if needed.
# (docker compose up does NOT use this file; env is injected via docker-compose.yml.)
# (npm run dev loads .env automatically via dotenv.)

# Required: a reachable Postgres. For local dev against the db container,
# publish the db port via docker-compose.override.yml and use:
DATABASE_URL=postgres://logs:logs@localhost:5433/logs

# Optional — defaults shown
PORT=8080
RETENTION_DAYS=30
INGEST_FLUSH_INTERVAL_MS=50
INGEST_FLUSH_BATCH_SIZE=750
INGEST_FLUSH_MAX_ENTRIES=8000
INGEST_BUFFER_MAX=50000
